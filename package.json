    "sim": "vite && evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.14",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "fs": "^0.0.1-security",
    "opencc-js": "1.4.2",
    "playwright": "^1.58.2",
    "stream": "^0.0.3"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@types/node": "^25.1.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
