  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "evenhub qr --path \"/\" --http && vite",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.14",
