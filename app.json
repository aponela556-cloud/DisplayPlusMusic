{
  "package_id": "com.aponela556.displaylyricmusic",
  "edition": "202601",
  "name": "DisplayLyric Music",
  "author": "aponela556",
  "version": "2.6.2",
  "min_app_version": "2.2.9",
  "min_sdk_version": "0.0.14",
  "entrypoint": "index.html",
  "tagline": "Music and local LRC sync for Even Hub",
  "description": "Music viewer for Even Hub with playback controls, synced lyrics, and local LRC timing tools.",
  "permissions": [
    {
      "name": "network",
      "desc": "This app needs to access the network in order to get music information and lyrics.",
      "whitelist": [
        "https://aponela556-cloud.github.io/displaylyric-oauth",
        "https://aponela556-cloud.github.io/displaylyric-oauth/",
        "https://accounts.spotify.com/authorize",
        "https://accounts.spotify.com/api/token",
        "https://api.spotify.com/v1/",
        "https://api.spotify.com/v1/me/player",
        "https://api.spotify.com/v1/me/player/devices",
        "https://api.spotify.com/v1/me/player/queue",
        "https://api.spotify.com/v1/me/player/play",
        "https://api.spotify.com/v1/me/player/pause",
        "https://api.spotify.com/v1/me/player/seek",
        "https://api.spotify.com/v1/me/player/next",
        "https://api.spotify.com/v1/me/player/previous",
        "https://i.scdn.co",
        "https://lrclib.net/api/get",
        "https://lrclib.net/api/search"
      ]
    }
  ],
  "supported_languages": [
    "en"
  ]
}
